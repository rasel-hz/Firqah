# Llama provider (any OpenAI-compatible chat-completions API).
# Copy this file to .env.local and fill the values. NEVER commit .env.local.
#
# Base URL: copy it from your provider's official docs (it usually ends with /v1 or /openai/v1).
LLAMA_API_BASE_URL=
# Your secret key from the provider's dashboard.
LLAMA_API_KEY=
# Exact Llama model id as listed by the provider (copy it from their model list; do not guess).
LLAMA_MODEL=
# Optional: set to "off" if your provider rejects JSON mode (response_format).
LLAMA_JSON_MODE=on
